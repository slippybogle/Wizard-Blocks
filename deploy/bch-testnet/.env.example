# Copy to .env and edit. Keep this file private (it holds the RPC password).

# chipnet (BCH upgrade-preview testnet, recommended) or testnet4
BCH_NETWORK=chipnet

# Node RPC credentials (used by both containers; pick a long random password)
RPC_USER=wizard
RPC_PASSWORD=change-me-to-something-long

# A bchtest: address you control (see README step 4). Required in fixed mode.
PAYOUT_MODE=fixed
PAYOUT_ADDRESS=

# Ports on the Umbrel host. 3333 is often taken (e.g. by Public Pool), so 3335.
STRATUM_PORT=3335
API_PORT=8090

# Node tuning: chipnet/testnet4 are small; prune only if disk is tight (>= 550)
BCHN_DBCACHE_MB=450
BCHN_PRUNE_MB=0

VARDIFF_INITIAL=512
LOG_LEVEL=info
