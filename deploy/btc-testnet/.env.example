# Copy to .env and edit. Keep this file private (it holds the RPC password).

# Node RPC credentials (used by both containers; pick a long random password)
RPC_USER=wizard
RPC_PASSWORD=change-me-to-something-long

# A testnet4 address you control (tb1q... / tb1p... / m... / n... / 2...).
# See README step 4. Required in fixed mode.
PAYOUT_MODE=fixed
PAYOUT_ADDRESS=

# Ports on the Umbrel host (separate from mainnet 1776 and bch-testnet 3335)
STRATUM_PORT=3336
API_PORT=8091

# Node tuning: testnet4 is small; prune only if disk is tight (>= 550)
BITCOIND_DBCACHE_MB=450
BITCOIND_PRUNE_MB=0

# Difficulty. FIXED_DIFF > 0 disables vardiff for everyone; a miner can pin
# its own difficulty with the password "d=512" (clamped to VARDIFF_MIN/MAX).
VARDIFF_INITIAL=512
VARDIFF_MIN=1
VARDIFF_MAX=1000000000000000
VARDIFF_TARGET_SECONDS=10
FIXED_DIFF=0

LOG_LEVEL=info
